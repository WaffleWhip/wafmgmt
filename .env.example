# ============================================================================
# wafmgmt configuration
#
# Copy to .env and edit. Every value is optional; compose has safe defaults.
#
# DEFAULT — single host (frontend + backend on the same machine):
#   Leave everything as-is. Frontend reaches the backend on 127.0.0.1.
#   Just run: docker compose up -d
#
# SPLIT — services on different servers:
#   Point BACKEND_URL at the machine that hosts wafmgmt-app. All modules
#   (core, usp, terminal) run in that single process. Example:
#     BACKEND_URL=http://10.0.0.5:3000
# ============================================================================

# --- Frontend (injected via env_file into waf-frontend) ---------------------
# Omit .env entirely and defaults still work on a single host.
PORT=3001
BACKEND_URL=http://127.0.0.1:3000

# --- Data storage ------------------------------------------------------------
# Host directory bind-mounted to /data (SQLite DBs, nginx conf, WG keys, certs).
# Keep it OUTSIDE the repo. Recommended on a server: /srv/wafmgmt
WAFMGMT_DATA_DIR=./data

# --- wafmgmt-app (single process: core + usp + terminal) --------------------
BACKEND_PORT=3000
USP_DB_PATH=/data/usp/wafmgmt.db
IDENTITY_DB_PATH=/data/identity.db
# MQTT broker for the USP module (may stay on a separate host)
BROKER_HOST=192.168.1.10
BROKER_PORT=1883
# Broker log for the "Broker Log" panel. When the broker is on another host the
# app tails this file over SSH (uses SSH_USER/SSH_PASSWORD above).
# BROKER_LOG_SSH=root@192.168.1.10
# BROKER_LOG_PATH=/root/wafmgmt/data/mosquitto/log/mosquitto.log

# --- Optional: TLS reverse proxy (proxy-tls) --------------------------------
# Only needed to terminate TLS / serve vhosts on 443. To disable it, comment
# out "infra/nginx/tls.docker-compose.yml" in the top-level docker-compose.yml.
PROXY_DOMAIN=ban.local
WAF_FRONTEND_UPSTREAM=http://127.0.0.1:3001

# --- Terminal SSH gateway (now part of wafmgmt-app) --------------------------
# /ssh is forwarded to the single wafmgmt-app process (WebSocket).
TERMINAL_UPSTREAM=http://127.0.0.1:3000
SSH_USER=root
SSH_PASSWORD=
SSH_CONNECT_TIMEOUT=10

# --- Backend <-> nginx route reload -----------------------------------------
# Backend writes conf.d routes and signals the nginx container via docker.sock.
NGINX_CONTAINER=proxy-tls
NGINX_CERT=/etc/nginx/certs/server.crt
NGINX_KEY=/etc/nginx/certs/server.key
DOCKER_SOCK=/var/run/docker.sock

# --- Optional: WireGuard ----------------------------------------------------
DEFAULT_WAN_ENDPOINT=
DEFAULT_DNS=10.8.0.1
DEFAULT_WG_ADDRESS=10.8.0.1/24
DEFAULT_WG_PORT=51820
WG_INTERFACE=wg0
DEFAULT_ALLOWED_IPS=10.8.0.0/24
WG_WAN_IP=
WG_WAN_IF=
WG_WAN_GW=
